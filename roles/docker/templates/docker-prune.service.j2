#
# {{ ansible_managed }}
#
[Unit]
Description=Remove Docker images no container uses, and old build cache
# Requisite, not Requires: a Docker stopped on purpose stays stopped
Requisite=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker image prune --all --force
ExecStart=/usr/bin/docker builder prune --all --force --filter until=168h
