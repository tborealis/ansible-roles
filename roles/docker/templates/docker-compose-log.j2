#!/bin/bash
#
# {{ ansible_managed }}
#
# Records an event of a Compose project:
#   docker-compose-log <project> <event> [key=value...]
# as a line in {{ docker_compose_log_dir }}/<project>.log and as a journal entry
# (identifier docker-compose) with fields COMPOSE_PROJECT, COMPOSE_EVENT and a
# COMPOSE_<KEY> per key=value, so `journalctl COMPOSE_PROJECT=<project>` lists
# a project's events.
set -euo pipefail

usage() {
    echo "Usage: docker-compose-log <project> <event> [key=value...]" >&2
    exit 2
}

[[ $# -ge 2 ]] || usage
PROJECT="$1"
EVENT="$2"
shift 2
[[ "$PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$ && "$EVENT" =~ ^[a-z][a-z-]*$ ]] || usage

FIELDS=()
for pair in "$@"; do
    [[ "$pair" =~ ^([a-z]+)=([^[:space:]]+)$ ]] || usage
    FIELDS+=("COMPOSE_${BASH_REMATCH[1]^^}=${BASH_REMATCH[2]}")
done

LINE="$EVENT${*:+ $*}"
printf '%s: %s\n' "$PROJECT" "$LINE" >&2
printf '%s\n' "MESSAGE=$PROJECT: $LINE" SYSLOG_IDENTIFIER=docker-compose \
    "COMPOSE_PROJECT=$PROJECT" "COMPOSE_EVENT=$EVENT" "${FIELDS[@]}" | logger --journald
printf '%s %s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" "$LINE" >> "{{ docker_compose_log_dir }}/$PROJECT.log"
