# {{ ansible_managed }}
# Sorts after Debian's security.conf in conf-enabled, so these values win.

ServerTokens {{ apache2_server_tokens }}
ServerSignature {{ apache2_server_signature }}

<IfModule ssl_module>
    SSLProtocol             {{ apache2_ssl_protocols }}
    SSLOpenSSLConfCmd       Curves {{ apache2_ssl_curves }}
    SSLCipherSuite          {{ apache2_ssl_ciphers }}
    SSLCipherSuite          TLSv1.3 TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    SSLHonorCipherOrder     off
    SSLSessionTickets       off
</IfModule>
