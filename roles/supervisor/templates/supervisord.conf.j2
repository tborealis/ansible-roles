;
; {{ ansible_managed }}
;

[unix_http_server]
file=/var/run/supervisor.sock
chmod=0770
chown=root:{{ supervisor_group }}

[supervisord]
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid
childlogdir=/var/log/supervisor
logfile_maxbytes=50MB
logfile_backups=10
loglevel=info

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix:///var/run/supervisor.sock

{% if supervisor_crashmail_enable %}
; The wrapper hands superlance the SMTP password from the environment, which only
; the listener's own user can read, rather than the command line.
[eventlistener:crashmailbatch]
command=/usr/local/bin/supervisor-crashmail crashmailbatch --toEmail="{{ supervisor_crashmail_to }}" --fromEmail="{{ supervisor_crashmail_from }}" --subject="{{ supervisor_crashmail_subject }}" --smtpHost="{{ supervisor_crashmail_smtp_host }}" --userName="{{ supervisor_crashmail_smtp_user }}" --tls
environment=CRASHMAIL_SMTP_PASSWORD="{{ supervisor_crashmail_smtp_password }}"
user=nobody
events=PROCESS_STATE,TICK_60

[eventlistener:fatalmailbatch]
command=/usr/local/bin/supervisor-crashmail fatalmailbatch --toEmail="{{ supervisor_crashmail_to }}" --fromEmail="{{ supervisor_crashmail_from }}" --subject="{{ supervisor_crashmail_subject_fatal }}" --smtpHost="{{ supervisor_crashmail_smtp_host }}" --userName="{{ supervisor_crashmail_smtp_user }}" --tls
environment=CRASHMAIL_SMTP_PASSWORD="{{ supervisor_crashmail_smtp_password }}"
user=nobody
events=PROCESS_STATE,TICK_60
{% endif %}

[include]
files=/etc/supervisor/conf.d/*.conf
