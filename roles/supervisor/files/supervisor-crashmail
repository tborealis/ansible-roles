#!/usr/bin/python3
# Runs a superlance mail listener (crashmailbatch or fatalmailbatch) with its SMTP
# password taken from $CRASHMAIL_SMTP_PASSWORD. superlance only accepts the password
# as an argument, and a process's arguments are readable by every local user, while
# its environment is readable only by its own user and root. Setting sys.argv here
# does not change the arguments the kernel shows for this process.
import os
import sys

from superlance import crashmailbatch, fatalmailbatch

LISTENERS = {"crashmailbatch": crashmailbatch, "fatalmailbatch": fatalmailbatch}

name = sys.argv[1]
sys.argv = [name, *sys.argv[2:], "--password", os.environ["CRASHMAIL_SMTP_PASSWORD"]]
LISTENERS[name].main()
